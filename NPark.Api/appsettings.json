{
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "ParkingBusiness": { "TimeZoneId": "Africa/Cairo" },
  "LprCapture": {
    "Enabled": true,
    "RetentionDays": 3,
    "ArchiveCheckIntervalMinutes": 60,
    "ArchiveBatchSize": 1000,
    "MaxMatchingAgeSeconds": null
  },
  "SubscriberButtonLock": {
    "Enabled": false,
    "SupportedControllerIds": [],
    "DuplicateWindowSeconds": 60
  },
  "MqttParkingEvents": {
    "Enabled": false,
    "SubscriptionQos": 1
  },
  "AutomaticVisitorEntry": {
    "Enabled": false,
    "SystemUserId": null,
    "SupportedControllerIds": []
  },
  "GateOperation": {
    "CommandTopicTemplate": "sub/network/{controllerId}",
    "AckTopicFilter": "ack/network/#",
    "CommandQos": 1,
    "AckQos": 1,
    "Retain": false,
    "DispatchWaitTimeoutSeconds": 10,
    "AckTimeoutSeconds": 3,
    "RequireAcknowledgment": true,
    "RecoveryIntervalSeconds": 2
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowAnyOrigin": false,
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://192.168.1.14:8080",
      "http://192.168.1.42:8080",
      "https://localhost:4200",
      "http://localhost:8080",
      "http://192.168.1.12:4200",
      "http://192.168.1.54:8009"
    ]
  },
  "ConnectionStrings": {
    "Database": "Server=.\\SQLEXPRESS;Database=NPARK;User Id=sa;Password=Atlo@2026;MultipleActiveResultSets=true;TrustServerCertificate=True;"
  },
  "EncryptionOptions": {
    "KeyBase64": "p3qfQp5Qq2a4d7y7h1o1u0v7C0XrHc8Yz3a2Oe0Hq2E="
  },
  "Jwt": {
    "Secret": "Trk5STh5K7v127v!v9ps&nfk7CYS!dKaLr",
    "Issuer": "NPARK",
    "Audience": "NPARK",
    "ExpiryMinutes": 600
  },
  "Camera": {
    "Enabled": true,
    "DeviceServiceUrl": "http://192.168.1.200/onvif/device_service",
    "Username": "admin",
    "Password": "admin1234",
    "TimeoutSeconds": 15,
    "SnapshotUrlOverride": null
  },
  "MqttNetworkSubscriber": {
    "Enabled": true,
    "TopicFilter": "publish/network/#",
    "Qos": 1,
    "ReconnectSeconds": 3
  },
  "MqttHeartbeat": {
    "Enabled": true,
    "IntervalSeconds": 20,
    "TopicPrefix": "sub/network",
    "DeviceId": "FF",
    "Payload": "7B FF A3 1A 2A 3A 4A 7D",
    "Qos": 1,
    "Retain": false
  },
  "SalaryConfig": {
    "Salary": 5000.00,
    "AllowedTime": "02:00:00"
  },
  "Mqtt": {
    "Host": "192.168.1.40",
    "Port": 1883,
    "ClientId": "npark-api",
    "Username": "",
    "Password": "",
    "KeepAliveSeconds": 20,
    "ReconnectSeconds": 3,
    "UseTls": false
  },
  "Logging": {
    "Sampling": {
      "Enabled": false,
      "KeepRate": 0.1,
      "MaxLevelToSample": "Information"
    },
    "Durable": {
      "ReplayOnStart": true,
      "MaxReplayBatch": 5000
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq",
      "Serilog.Sinks.File",
      "Serilog.Sinks.Async",
      "Serilog.Enrichers.Process",
      "Serilog.Enrichers.Thread",
      "Serilog.Enrichers.Environment",
      "Serilog.Expressions",
      "Serilog.Formatting.Compact",
      "Serilog.Settings.Configuration"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithProcessId", "WithThreadId" ],
    "Filter": [
      {
        "Name": "ByExcluding",
        "Args": { "expression": "EndsWith(RequestPath, '/health')" }
      },
      {
        "Name": "ByExcluding",
        "Args": { "expression": "coalesce(RequestPath, '') like '/swagger%'" }
      }
    ],
    "WriteTo": [
      {
        "Name": "Logger",
        "Args": {
          "configureLogger": {
            "Filter": [
              {
                "Name": "ByIncludingOnly",
                "Args": { "expression": "IsDefined(IsAudit) and IsAudit = true" }
              }
            ],
            "WriteTo": [
              {
                "Name": "File",
                "Args": {
                  "path": "logs/audit-.ndjson",
                  "rollingInterval": "Day",
                  "retainedFileCountLimit": 14,
                  "fileSizeLimitBytes": 104857600,
                  "rollOnFileSizeLimit": true,
                  "shared": false,
                  "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
                }
              }
            ]
          }
        }
      },
      {
        "Name": "Async",
        "Args": {
          "bufferSize": 32768,
          "blockWhenFull": false,
          "configure": [
            { "Name": "Console" },
            {
              "Name": "Seq",
              "Args": {
                "serverUrl": "http://localhost:8002",
                "apiKey": null,
                "bufferBaseFilename": "logs/seq-buffer/buffer",
                "restrictedToMinimumLevel": "Information"
              }
            },
            {
              "Name": "File",
              "Args": {
                "path": "logs/failover-.ndjson",
                "rollingInterval": "Day",
                "retainedFileCountLimit": 7,
                "fileSizeLimitBytes": 104857600,
                "rollOnFileSizeLimit": true,
                "shared": false,
                "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact",
                "restrictedToMinimumLevel": "Information"
              }
            }
          ]
        }
      }
    ]
  }
}
